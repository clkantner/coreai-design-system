{
  "name": "@coreai-ds/docsite",
  "version": "0.0.0",
  "private": true,
  "description": "CoreAI design system documentation site — a React SPA built on the @coreai-ds/react-components package.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:content": "node scripts/generate-content.mjs",
    "generate:content:refresh": "node scripts/generate-content.mjs --refresh-storybook",
    "dev": "npm run generate:content && vite",
    "build": "node scripts/generate-content.mjs --require-storybook-markdown && vite build",
    "sources:ensure": "node scripts/sources/setup-fluent-stories.mjs --if-missing",
    "sources:update": "node scripts/sources/setup-fluent-stories.mjs",
    "catalog:init": "node scripts/initialize-reference-catalog.mjs",
    "build:reference-proof": "npm run sources:ensure && npm --workspace @coreai-ds/react-components run build && node scripts/build-reference-proof.mjs",
    "preview:reference-proof": "node scripts/serve-reference-proof.mjs",
    "test:reference-proof": "node --test test/reference-proof.test.mjs test/reference-navigation.test.mjs test/standalone-pages.test.mjs",
    "verify:reference-proof": "node scripts/verify-reference-proof.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "type-check": "npm run generate:content && tsc --noEmit",
    "clean": "rimraf dist content/generated"
  },
  "dependencies": {
    "@coreai-ds/react-components": "*",
    "@ctrl/tinycolor": "^3.6.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.0",
    "@fluentui/react-icons": "^2.0.300",
    "@fluentui/react-jsx-runtime": "^9.4.6",
    "@fluentui/react-motion-components-preview": "^0.15.5",
    "@fluentui/react-utilities": "^9.26.4",
    "@paper-design/shaders": "0.0.81",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "6.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "react-window": "^1.8.10",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "remark-stringify": "^11.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.5.4",
    "vite": "^6.3.5"
  }
}
